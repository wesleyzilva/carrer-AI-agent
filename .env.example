# Caminho do banco SQLite
CAREER_DB_PATH=./data/career.db

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_LONG=llama3.1:8b
OLLAMA_MODEL_FALLBACK=mistral:7b

# Logs: json | pretty
LOG_FORMAT=pretty
LOG_LEVEL=info

# ---- Perfil canônico (contato nunca vai para o repositório) ----
PROFILE_EMAIL=
PROFILE_PHONE=
PROFILE_STATE=SP
PROFILE_LINKEDIN=https://www.linkedin.com/in/seu-perfil
PROFILE_GITHUB=
# Opcional: sobrescrever headline/about gerados por persona
# PROFILE_HEADLINE=
# PROFILE_ABOUT=

# ---- Credenciais por plataforma (fallback: CRED_DEFAULT_*) ----
CRED_DEFAULT_EMAIL=
CRED_DEFAULT_PASSWORD=
# CRED_LINKEDIN_EMAIL=
# CRED_LINKEDIN_PASSWORD=
# CRED_INDEED_EMAIL=
# CRED_INDEED_PASSWORD=
# CRED_GUPY_EMAIL=
# CRED_GUPY_PASSWORD=
# CRED_GLASSDOOR_EMAIL=
# CRED_GLASSDOOR_PASSWORD=

# ---- Navegador ----
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=./data/browser-profile
SCREENSHOT_DIR=./data/screenshots
# BROWSER_CHANNEL=chrome        # usar o Chrome instalado em vez do Chromium do Playwright
INDEED_DOMAIN=br.indeed.com     # ou www.indeed.com
