{
  "name": "career-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma local-first de inteligência de carreira: descobre, pontua e automatiza candidaturas.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty",
    "db:generate": "pnpm --filter @career/db run generate",
    "db:migrate": "pnpm --filter @career/db run migrate",
    "career": "tsx apps/cli/src/main.ts",
    "browsers:install": "pnpm --filter @career/browser exec playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
